# =====================================================================
# SICA-VS — Plantilla de variables de entorno de PRODUCCIÓN (VPS)
#
# Distinto de .env.example (que es para desarrollo local). Este archivo
# se usa junto con docker-compose.prod.yml, en el VPS.
#
# Copiar a .env EN EL VPS y completar TODOS los valores marcados.
# Este archivo (.env.prod.example) SÍ va al repo -- es solo la
# plantilla, sin secretos reales. El .env real NUNCA se commitea.
#
# Uso en el VPS:
#   cp .env.prod.example .env
#   nano .env          # completar los valores
#   docker compose -f docker-compose.prod.yml up -d --build
# =====================================================================

# ── Base de datos ──────────────────────────────────────────────────
# Contraseña real y fuerte para Postgres -- NUNCA la de desarrollo
# (sicavs_dev). Generar una nueva, por ejemplo:  openssl rand -base64 24
POSTGRES_DB=sicavs
POSTGRES_USER=sicavs
POSTGRES_PASSWORD=

# ── Autenticación ───────────────────────────────────────────────────
# Clave para firmar los tokens de sesión (JWT). Larga y aleatoria --
# NUNCA la de desarrollo ("cambiar_esto_en_produccion").
# Generar con:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_HOURS=12

# Dominio real del sitio, CON https:// -- el navegador solo deja que el
# frontend llame al backend si coincide con esto.
CORS_ORIGINS=https://patronatovillasdelsol.com

# WebAuthn (login con huella/biometría). RP_ID es el dominio SIN
# https://; ORIGIN es la URL completa CON https://. Las huellas
# registradas solo funcionan con estos valores exactos -- si cambian
# más adelante, todos deben volver a registrar su huella.
WEBAUTHN_RP_ID=patronatovillasdelsol.com
WEBAUTHN_ORIGIN=https://patronatovillasdelsol.com

# ── Almacenamiento de archivos — DigitalOcean Spaces ─────────────────
# Decisión del Día 58: NO usar el disco del VPS -- si se llena, tumba
# el servidor entero. Spaces es almacenamiento de objetos aparte, con
# su propio límite independiente del disco del servidor.
#
# Crear el bucket y las llaves en:
#   https://cloud.digitalocean.com/spaces        (crear el bucket)
#   https://cloud.digitalocean.com/account/api/spaces  (generar las llaves
#     -- son DISTINTAS de las llaves de API de Droplets)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=sica-vs-archivos
SPACES_REGION=nyc3
# La URL del CDN del bucket (la muestra el panel de DO al crear el
# bucket). Formato: https://<bucket>.<region>.cdn.digitaloceanspaces.com
SPACES_CDN_URL=

# ── Correo (Resend) ─────────────────────────────────────────────────
# Para el correo de activación de cuenta de un residente. Si se deja
# vacío, esa función queda deshabilitada silenciosamente (no rompe nada).
RESEND_API_KEY=

# ── Otros (opcionales — dejar vacío si todavía no se usan) ───────────
LOGO_URL=
GOOGLE_ISSUER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Límites de tasa (dejar los valores por defecto salvo que haga
#    falta ajustar) ───────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=600 per hour
LOGIN_RATE_LIMIT_OVERRIDE=
