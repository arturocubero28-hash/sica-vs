# =====================================================================
# SICA-VS — Variables de entorno
# Copiar este archivo a .env  →  cp .env.example .env
# =====================================================================

# Base de datos
DATABASE_URL=postgresql://sicavs:sicavs_dev@db:5432/sicavs

# Redis (caché, sesiones en vivo, Celery)
REDIS_URL=redis://redis:6379/0

# Seguridad — CAMBIAR en producción por una clave larga y aleatoria
JWT_SECRET=cambiar_esto_en_produccion
JWT_EXPIRES_HOURS=12

# CORS: de dónde se permite consumir la API
CORS_ORIGINS=http://localhost:5173

# Resend (notificaciones por correo) — pegar la API key cuando se tenga
RESEND_API_KEY=

# WebAuthn (biometría)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SICA-VS Villas del Sol
WEBAUTHN_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:5000/api/v1
